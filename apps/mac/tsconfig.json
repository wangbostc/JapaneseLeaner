{
  // React rendered by gpuix, not the DOM: no DOM types, and JSX from @gpuix/react.
  "compilerOptions": {
    "tsBuildInfoFile": "../../node_modules/.tmp/tsconfig.mac.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023"],
    "types": ["bun", "node"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "jsxImportSource": "@gpuix/react",
    "resolveJsonModule": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "skipLibCheck": true,
    "noEmit": true,
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src", "test", "*.ts", "../../packages/core/src/kuromoji.d.ts"]
}
